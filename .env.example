# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Safe reference file (no real secrets, always committed)
# Copy this file to .env.local and fill in your actual values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Database + Auth) ────────────────────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# ⚠️  SERVER ONLY — has full DB access, bypasses RLS. Never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Groq API (AI Analysis) ────────────────────────────────────────────────────
# Found in: console.groq.com → API Keys
# ⚠️  SERVER ONLY
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Scraper (Outscraper / Scrapingdog) ────────────────────────────────────────
# Found in: your scraper provider's dashboard → API section
# ⚠️  SERVER ONLY
SCRAPER_API_KEY=your_scraper_api_key_here
SCRAPER_PROVIDER=outscraper   # or: scrapingdog

# ── Razorpay (Payments) ───────────────────────────────────────────────────────
# Found in: dashboard.razorpay.com → Settings → API Keys
# Key ID is safe for client-side (used to initialise Razorpay checkout)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
# ⚠️  SERVER ONLY — used to verify signatures and create orders server-side
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ── App Config ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Verdict AI

# ── Rate Limiting (Upstash Redis — all optional, defaults shown) ──────────────
# /api/analyze — per authenticated user ID (protects Groq API costs)
RATE_LIMIT_ANALYZE_REQUESTS=10
RATE_LIMIT_ANALYZE_WINDOW=60s
# Public endpoints (/api/create-order, /api/feedback/general) — per IP
RATE_LIMIT_PUBLIC_REQUESTS=30
RATE_LIMIT_PUBLIC_WINDOW=60s
# Admin endpoints (/api/admin/*) — per authenticated admin user ID
RATE_LIMIT_ADMIN_REQUESTS=60
RATE_LIMIT_ADMIN_WINDOW=60s

# UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
